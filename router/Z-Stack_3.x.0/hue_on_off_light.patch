+/*********************************************************************
+ * @fn      zclGenericApp_UpdateOnOff
+ *
+ * @brief   Update the virtual light state and schedule attribute reporting.
+ */
+static void zclGenericApp_UpdateOnOff( uint8_t onOff )
+{
+  onOff = onOff ? TRUE : FALSE;
+
+  if ( zclGenericApp_OnOff == onOff )
+  {
+    return;
+  }
+
+  zclGenericApp_OnOff = onOff;
+  zclGenericApp_ScenesValid = FALSE;
+
+#ifdef BDB_REPORTING
+  zstack_bdbRepChangedAttrValueReq_t req;
+  req.attrID = ATTRID_ON_OFF_ON_OFF;
+  req.cluster = ZCL_CLUSTER_ID_GENERAL_ON_OFF;
+  req.endpoint = GENERICAPP_ENDPOINT;
+  Zstackapi_bdbRepChangedAttrValueReq( appServiceTaskId, &req );
+#endif
+}
+
+/*********************************************************************
+ * @fn      zclGenericApp_OnOffCB
+ *
+ * @brief   Handle OFF, ON and TOGGLE without driving physical hardware.
+ */
+static void zclGenericApp_OnOffCB( uint8_t cmd )
+{
+  switch ( cmd )
+  {
+    case COMMAND_ON_OFF_OFF:
+      zclGenericApp_UpdateOnOff( FALSE );
+      break;
+
+    case COMMAND_ON_OFF_ON:
+      zclGenericApp_UpdateOnOff( TRUE );
+      break;
+
+    case COMMAND_ON_OFF_TOGGLE:
+      zclGenericApp_UpdateOnOff( !zclGenericApp_OnOff );
+      break;
+
+    default:
+      break;
+  }
+}
+
+/*********************************************************************
+ * @fn      zclGenericApp_SceneRecallCB
+ *
+ * @brief   Restore the On/Off extension field from a recalled scene.
+ */
+static void zclGenericApp_SceneRecallCB( zclSceneReq_t *pReq )
+{
+  uint8_t *pBuf;
+  uint8_t extLen = 0;
+
+  if ( ( pReq == NULL ) || ( pReq->scene == NULL ) )
+  {
+    return;
+  }
+
+  pBuf = pReq->scene->extField;
+  while ( ( extLen + 3 ) <= ZCL_GENERAL_SCENE_EXT_LEN )
+  {
+    uint16_t clusterId = BUILD_UINT16( pBuf[0], pBuf[1] );
+    uint8_t attrLen = pBuf[2];
+    uint8_t fieldLen;
+
+    if ( ( attrLen == 0xFF ) || ( clusterId == 0xFFFF ) )
+    {
+      break;
+    }
+
+    fieldLen = (uint8_t)( sizeof( uint16_t ) + sizeof( uint8_t ) + attrLen );
+    if ( (uint8_t)( extLen + fieldLen ) > ZCL_GENERAL_SCENE_EXT_LEN )
+    {
+      break;
+    }
+
+    if ( ( clusterId == ZCL_CLUSTER_ID_GENERAL_ON_OFF ) && ( attrLen >= 1 ) )
+    {
+      zclGenericApp_UpdateOnOff( pBuf[3] );
+    }
+
+    pBuf += fieldLen;
+    extLen += fieldLen;
+  }
+
+  zclGenericApp_ScenesValid = TRUE;
+  zclGenericApp_ScenesCurrentGroup = pReq->scene->groupID;
+  zclGenericApp_ScenesCurrentScene = pReq->scene->ID;
+}
+
+/*********************************************************************
+ * @fn      zclGenericApp_SceneStoreCB
+ *
+ * @brief   Save the virtual On/Off state in a scene extension field.
+ */
+static uint8_t zclGenericApp_SceneStoreCB( zclSceneReq_t *pReq )
+{
+  uint8_t *pBuf;
+  uint8_t extLen = 0;
+  uint8_t sceneChanged = FALSE;
+
+  if ( ( pReq == NULL ) || ( pReq->scene == NULL ) )
+  {
+    return FALSE;
+  }
+
+  pBuf = pReq->scene->extField;
+  while ( ( extLen + 3 ) <= ZCL_GENERAL_SCENE_EXT_LEN )
+  {
+    uint16_t clusterId = BUILD_UINT16( pBuf[0], pBuf[1] );
+    uint8_t attrLen = pBuf[2];
+    uint8_t fieldLen;
+
+    if ( ( attrLen == 0xFF ) || ( clusterId == 0xFFFF ) )
+    {
+      break;
+    }
+
+    fieldLen = (uint8_t)( sizeof( uint16_t ) + sizeof( uint8_t ) + attrLen );
+    if ( (uint8_t)( extLen + fieldLen ) > ZCL_GENERAL_SCENE_EXT_LEN )
+    {
+      break;
+    }
+
+    if ( ( clusterId == ZCL_CLUSTER_ID_GENERAL_ON_OFF ) && ( attrLen >= 1 ) )
+    {
+      if ( pBuf[3] != zclGenericApp_OnOff )
+      {
+        sceneChanged = TRUE;
+      }
+      pBuf[3] = zclGenericApp_OnOff;
+    }
+
+    pBuf += fieldLen;
+    extLen += fieldLen;
+  }
+
+  zclGenericApp_ScenesValid = TRUE;
+  zclGenericApp_ScenesCurrentGroup = pReq->scene->groupID;
+  zclGenericApp_ScenesCurrentScene = pReq->scene->ID;
+
+  return sceneChanged;
+}
+
+/*********************************************************************
+ * @fn      zclGenericApp_ReadWriteAttrCB
+ *
+ * @brief   Supply the dynamic Scenes.SceneCount attribute.
+ */
+static ZStatus_t zclGenericApp_ReadWriteAttrCB( uint16_t clusterId, uint16_t attrId,
+                                               uint8_t oper, uint8_t *pValue,
+                                               uint16_t *pLen )
+{
+  if ( ( clusterId == ZCL_CLUSTER_ID_GENERAL_SCENES ) &&
+       ( attrId == ATTRID_SCENES_SCENE_COUNT ) )
+  {
+    return zclGeneral_ReadSceneCountCB( clusterId, attrId, oper, pValue, pLen );
+  }
+
+  return ZSuccess;
+}
